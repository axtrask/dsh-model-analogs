{
  "name": "dsh-model-analogs",
  "version": "0.1.0",
  "type": "module",
  "description": "Add a pi-ai model by analogy with an installed catalog model: pick the analogy, name the new model, and the plugin writes it into llm-pi-ai's configuration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axtrask/dsh-model-analogs.git"
  },
  "homepage": "https://github.com/axtrask/dsh-model-analogs#readme",
  "bugs": {
    "url": "https://github.com/axtrask/dsh-model-analogs/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.0-rc.2 || ^0.2.1-rc.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./plugin": "./lib/plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
